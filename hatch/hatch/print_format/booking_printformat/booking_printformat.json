 "html": "<div class=\"container\">\n\n    <h2 class=\"text-center\">Booking</h2>\n\n    <table class=\"table table-bordered\">\n        <tr>\n            <th>Member</th>\n            <td>{{ doc.member }}</td>\n        </tr>\n        <tr>\n            <th>Resource</th>\n            <td>{{ doc.resource }}</td>\n        </tr>\n        <tr>\n            <th>Booking Date</th>\n            <td>{{ doc.booking_date }}</td>\n        </tr>\n        <tr>\n            <th>Start Time</th>\n            <td>{{ doc.start_time }}</td>\n        </tr>\n        <tr>\n            <th>End Time</th>\n            <td>{{ doc.end_time }}</td>\n        </tr>\n        <tr>\n            <th>Headcount</th>\n            <td>{{ doc.headcount }}</td>\n        </tr>\n        <tr>\n            <th>Total Amount</th>\n            <td style=\"font-weight: bold\">{{ doc.total_amount }}</td>\n        </tr>\n        \n    {% if doc.addons %}\n        <tr>\n            <th>Add-ons</th>\n            <td>\n                <table class=\"table table-bordered\">\n                    <thead>\n                        <tr>\n                            <th>Service</th>\n                            <th>Qty</th>\n                            <th>Rate</th>\n                            <th>Amount</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for row in doc.addons %}\n                        <tr>\n                            <td>{{ row.service_name }}</td>\n                            <td>{{ row.quantity }}</td>\n                            <td>{{ row.rate }}</td>\n                            <td>{{ row.amount }}</td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                </table>\n            </td>\n        </tr>\n        {% endif %}\n\n        {% if doc.status == \"Pending Confirmation\" %}\n        <tr>\n            <td colspan=\"2\" class=\"text-center\">\n                <h3 style=\"font-weight: bold;\">NOT YET CONFIRMED \u2014 Hold your seat</h3>\n            </td>\n        </tr>\n        {% endif %}\n    </table>\n\n</div>\n",
